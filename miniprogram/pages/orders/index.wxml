<view class="page">
  <text class="eyebrow">YOUR ORDERS</text><view class="title">每一份期待</view>
  <view wx:if="{{!loggedIn}}" class="empty"><view class="subtitle">登录后查看你的订单。</view><button class="primary" bindtap="login">登录 / 注册</button></view>
  <block wx:else>
    <view class="filters"><button wx:for="{{filters}}" wx:key="value" class="filter {{filter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</button></view>
    <view wx:if="{{loading}}" class="empty muted">正在载入订单…</view>
    <view wx:elif="{{error}}" class="empty"><view class="error">{{error}}</view><button class="secondary" bindtap="load">重试</button></view>
    <view wx:elif="{{!orders.length}}" class="empty"><view class="subtitle">这里还没有订单。</view><button class="primary" bindtap="browse">去看看好物</button></view>
    <block wx:else><view wx:for="{{orders}}" wx:key="id" class="panel">
      <view class="row"><text class="muted">订单 #{{item.id}}</text><text class="pill">{{item.statusLabel}}</text></view>
      <view wx:for="{{item.items}}" wx:for-item="line" wx:key="id" class="order-line"><view>{{line.name}}</view><view class="row muted"><text>{{line.priceText}}</text><text>× {{line.quantity}}</text></view></view>
      <view class="divider"></view><view class="row"><text class="muted">{{item.dateText}}</text><text class="price">{{item.totalText}}</text></view>
      <view class="address muted">{{item.recipient}} · {{item.country}}<view>{{item.address}}</view></view>
      <view wx:if="{{item.tracking}}" class="notice break">物流单号 {{item.tracking}}</view>
      <view wx:if="{{item.status === 'PENDING'}}" class="actions"><button class="secondary" data-id="{{item.id}}" data-action="cancel" bindtap="act" disabled="{{busy}}">取消订单</button><button wx:if="{{demo}}" class="primary" data-id="{{item.id}}" data-action="pay" bindtap="act" disabled="{{busy}}">模拟付款</button></view>
    </view></block>
  </block>
</view>
