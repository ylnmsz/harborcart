.hero { background: #dcecf3; border-radius: 28rpx; padding: 34rpx; height: 350rpx; position: relative; overflow: hidden; }
.hero-copy { position: relative; z-index: 1; max-width: 420rpx; }
.hero-title { font-size: 56rpx; line-height: 1.25; font-weight: 700; margin: 18rpx 0; }
.hero-image { position: absolute; width: 300rpx; height: 300rpx; right: -45rpx; top: 0; transform: rotate(12deg); }
.hero-stamp { position: absolute; right: 24rpx; bottom: 25rpx; background: #ddecad; padding: 10rpx 16rpx; border-radius: 8rpx; font-size: 20rpx; transform: rotate(-5deg); }
.search { margin: 28rpx 0 24rpx; display: flex; align-items: center; background: #fff; border: 1rpx solid #dce6ec; padding: 18rpx 24rpx; border-radius: 16rpx; }
.search-mark { font-size: 40rpx; margin-right: 20rpx; color: #587a8e; }
.search input { flex: 1; min-width: 0; height: 48rpx; font-size: 25rpx; }
.categories { display: flex; gap: 10rpx; }
.category { flex: 1; padding: 18rpx 4rpx; border-radius: 12rpx; background: transparent; font-size: 24rpx; color: #687d8a; white-space: nowrap; }
.category.selected { background: #245b78; color: #fff; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.product-card { background: #fff; border-radius: 22rpx; overflow: hidden; border: 1rpx solid #e3ebef; }
.product-art { background: #eaf1f4; height: 270rpx; position: relative; }
.product-art image { width: 100%; height: 100%; }
.stock { position: absolute; bottom: 12rpx; left: 16rpx; background: #fff; padding: 6rpx 12rpx; font-size: 22rpx; border-radius: 8rpx; }
.product-info { padding: 22rpx; }
.product-name { font-size: 27rpx; font-weight: 600; min-height: 82rpx; margin: 10rpx 0; line-height: 1.4; }
.product-price { font-size: 26rpx; font-weight: 650; }
.arrow { color: #245b78; font-size: 30rpx; }
.footer-note { text-align: center; color: #687d8a; font-size: 22rpx; padding-top: 36rpx; }
