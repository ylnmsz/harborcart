.detail-page { padding-bottom: 180rpx; }
.detail-art { background: #e2edf2; border-radius: 28rpx; height: 510rpx; margin-bottom: 30rpx; }
.detail-art image { width: 100%; height: 100%; }
.detail-title { font-size: 43rpx; font-weight: 650; line-height: 1.3; margin: 24rpx 0 16rpx; }
.description { margin: 24rpx 0 30rpx; color: #687d8a; font-size: 27rpx; line-height: 1.75; }
.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 20rpx; padding: 24rpx 32rpx; background: #fff; border-top: 1rpx solid #e3ebef; }
.bottom-actions .primary { flex: 1; }
